        "required": [
          "module",
          "module_name",
          "submodule",
          "label"
        ],
        "title": "MatrixColumn",
        "type": "object"
      },
      "MatrixOut": {
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/MatrixColumn"
            },
            "title": "Columns",
            "type": "array"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/MatrixRow"
            },
            "title": "Rows",
