            "items": {
              "$ref": "#/components/schemas/SubmoduleOut"
            },
            "title": "Submodules",
            "type": "array"
          },
          "visible_to_staff": {
            "title": "Visible To Staff",
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "name",
          "icon",
          "route",
          "visible_to_staff",
          "staff_eligible",
          "submodules"
        ],
        "title": "ModuleAdminOut",
        "type": "object"
      },
      "OtpRequestIn": {
        "properties": {
          "email": {
            "format": "email",
