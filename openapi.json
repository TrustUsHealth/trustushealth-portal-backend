            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "kind"
        ],
        "title": "SubmoduleOut",
        "type": "object"
      },
      "TileOut": {
        "description": "One dashboard tile. State comes from the server; the frontend never decides who sees what.",
        "properties": {
          "icon": {
            "title": "Icon",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "route": {
            "title": "Route",
            "type": "string"
          },
          "state": {
            "enum": [
              "open",
              "locked",
              "pending"
            ],
            "title": "State",
            "type": "string"
          },
          "submodules": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SubmoduleOut"
            },
            "title": "Submodules",
            "type": "array"
          },
          "visible_to_staff": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
