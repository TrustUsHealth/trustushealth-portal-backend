        ],
        "title": "GrantIn",
        "type": "object"
      },
      "GrantOut": {
        "properties": {
          "granted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Granted At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "module": {
            "title": "Module",
            "type": "string"
          },
          "requested_at": {
            "anyOf": [
              {
                "format": "date-time",
