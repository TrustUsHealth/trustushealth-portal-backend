            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "OtpRequestIn",
        "type": "object"
      },
      "OtpRequestedOut": {
        "description": "Identical whether or not the email is registered (no account enumeration).",
        "properties": {
          "message": {
            "default": "If this email is registered, a login code has been sent.",
            "title": "Message",
            "type": "string"
          },
          "resend_after_seconds": {
            "title": "Resend After Seconds",
            "type": "integer"
          }
        },
        "required": [
          "resend_after_seconds"
        ],
        "title": "OtpRequestedOut",
        "type": "object"
      },
      "OtpVerifyIn": {
        "properties": {
          "code": {
            "maxLength": 8,
            "minLength": 6,
            "pattern": "^\\d+$",
            "title": "Code",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "title": "OtpVerifyIn",
        "type": "object"
      },
      "PartnerOut": {
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "key",
          "name"
        ],
        "title": "PartnerOut",
        "type": "object"
      },
      "SubmoduleOut": {
        "properties": {
