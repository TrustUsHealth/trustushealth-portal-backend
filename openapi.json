                  "title": "Response Access Modules",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Modules",
        "tags": [
          "access"
        ]
      }
    },
