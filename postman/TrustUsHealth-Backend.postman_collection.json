        {
          "name": "Access matrix",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/access/matrix" },
          "response": []
        }
      ]
    },
    {
      "name": "PR1 - Patient Registry: Setup",
      "description": "Run first (as Admin). Confirms the module is mounted and the form definition comes from fields.yaml.",
      "item": [
        {
          "name": "Dashboard tile present",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('patient_registry tile is open', function () {",
                  "  const t = pm.response.json().find(function (x) { return x.key === 'patient_registry'; });",
                  "  pm.expect(t, 'tile missing').to.exist;",
                  "  pm.expect(t.state).to.eql('open');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/me/modules" },
          "response": []
        },
        {
          "name": "Field list (form definition)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and standard fields', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const keys = pm.response.json().map(function (f) { return f.key; });",
                  "  ['bill_no','patient_name','registration_date','tests','partner_key','net_amount'].forEach(function (k) { pm.expect(keys).to.include(k); });",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/patient_registry/fields", "description": "Admin sees margin; Staff must not (admin_only field)." },
          "response": []
        }
      ]
    },
    {
      "name": "PR2 - Patient Registry: Upload and parse (golden samples)",
      "description": "Body is form-data. In each request, click the 'file' row and pick the sample PDF. Spectrum sample 02053062-2026-10-14.pdf must give Kalphem MS / 45 Y / Male / PID 0200118333 / Dr. Saumil Shah / 2026-10-14 / tests TSH (Thyroid Stimulating Hormone) + Sugar Fasting Blood. Metropolis sample must give Ramesh Gada / 52 Y / Male / P39326581861483 / Dr. Jatin Kothari / 2026-11-02 / Creatinine, Serum. Nothing is saved as an entry by these calls; the report is stored and reportId is saved.",
      "item": [
        {
          "name": "Parse Spectrum report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('reportId', j.report_id);",
                  "pm.test('Spectrum golden values', function () {",
                  "  pm.expect(j.fields.patient_name).to.eql('Kalphem MS');",
                  "  pm.expect(j.fields.age).to.eql(45);",
                  "  pm.expect(j.fields.age_unit).to.eql('Y');",
                  "  pm.expect(j.fields.gender).to.eql('Male');",
                  "  pm.expect(j.fields.lab_pid).to.eql('0200118333');",
                  "  pm.expect(j.fields.referred_by).to.eql('Dr. Saumil Shah');",
                  "  pm.expect(j.fields.registration_date).to.eql('2026-10-14');",
                  "  pm.expect(j.fields.collection_time).to.include('2026-10-14T11:26');",
                  "  pm.expect(j.fields.reporting_time).to.include('2026-10-14T15:07');",
                  "  pm.expect(j.fields.tests).to.eql(['TSH (Thyroid Stimulating Hormone)', 'Sugar Fasting Blood']);",
                  "});",
                  "pm.test('no verify flags, no mixed patients', function () { pm.expect(j.needs_verify).to.eql([]); pm.expect(j.flags).to.not.include('mixed_patients'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "partner_key", "value": "spectrum", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/v1/patient_registry/entries/parse",
            "description": "Pick tests/samples/spectrum/02053062-2026-10-14.pdf. Run it twice: the second response must have file_duplicate=true and the same report_id."
          },
          "response": []
        },
        {
          "name": "Parse Metropolis report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('reportId', j.report_id);",
                  "pm.test('Metropolis golden values', function () {",
                  "  pm.expect(j.fields.patient_name).to.eql('Ramesh Gada');",
                  "  pm.expect(j.fields.age).to.eql(52);",
                  "  pm.expect(j.fields.gender).to.eql('Male');",
                  "  pm.expect(j.fields.lab_pid).to.eql('P39326581861483');",
                  "  pm.expect(j.fields.referred_by).to.eql('Dr. Jatin Kothari');",
                  "  pm.expect(j.fields.registration_date).to.eql('2026-11-02');",
                  "  pm.expect(j.fields.collection_time).to.include('2026-11-02T16:11');",
                  "  pm.expect(j.fields.reporting_time).to.include('2026-11-02T18:01');",
                  "  pm.expect(j.fields.tests).to.eql(['Creatinine, Serum']);",
                  "  pm.expect(j.fields.phone).to.be.oneOf([null, undefined]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "partner_key", "value": "metropolis", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/v1/patient_registry/entries/parse",
            "description": "Pick tests/samples/metropolis/Report-260330104942890_RAMESHGADA_L9847_02Nov2026_161227.pdf."
          },
          "response": []
        },
        {
          "name": "Parse: home_lab must be refused (manual lab)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('400 manual lab', function () { pm.response.to.have.status(400); });"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "partner_key", "value": "home_lab", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/v1/patient_registry/entries/parse"
          },
          "response": []
        },
        {
          "name": "Parse: wrong file type must be refused",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('415 or 400', function () { pm.expect(pm.response.code).to.be.oneOf([400, 415, 422]); });"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "partner_key", "value": "spectrum", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/v1/patient_registry/entries/parse",
            "description": "Pick any .png/.txt, or a .txt renamed to .pdf (magic-byte check must reject it)."
          },
          "response": []
        },
        {
          "name": "Preview stored report (inline PDF)",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/patient_registry/reports/{{reportId}}/file", "description": "Use Send and Download in Postman to view the PDF." },
          "response": []
        },
        {
          "name": "Download stored report",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/patient_registry/reports/{{reportId}}/file?download=true" },
          "response": []
        }
      ]
    },
    {
      "name": "PR3 - Patient Registry: Entries and duplicate rules",
      "description": "Run in order on a fresh database. 1) create from the parsed Spectrum report (links reportId); 2) same PID again = exact match, merged, same bill_no; 3) conflicting value = 409 conflict; 4) resolve; 5) similar name different PID = 409 possible_match; 6) force_new = new bill_no; 7) edit; 8) search.",
      "item": [
        {
          "name": "1. Create entry from parsed Spectrum report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('entryId', j.entry.id);",
                  "pm.collectionVariables.set('targetEntryId', j.entry.id);",
                  "pm.collectionVariables.set('billNo', j.entry.bill_no);",
                  "pm.collectionVariables.set('entryVersion', j.entry.version);",
                  "pm.test('outcome created, 6-digit bill_no, draft (no amount yet)', function () {",
                  "  pm.expect(j.outcome).to.eql('created');",
                  "  pm.expect(j.entry.bill_no).to.match(/^\\d{6}$/);",
                  "  pm.expect(j.entry.status).to.eql('draft');",
                  "  pm.expect(j.report_link).to.eql('linked');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_key\": \"spectrum\",\n  \"patient_name\": \"Kalphem MS\",\n  \"registration_date\": \"2026-10-14\",\n  \"age\": 45,\n  \"age_unit\": \"Y\",\n  \"gender\": \"Male\",\n  \"lab_pid\": \"0200118333\",\n  \"referred_by\": \"Dr. Saumil Shah\",\n  \"collection_time\": \"2026-10-14T11:26:00\",\n  \"reporting_time\": \"2026-10-14T15:07:00\",\n  \"tests\": [\"TSH (Thyroid Stimulating Hormone)\", \"Sugar Fasting Blood\"],\n  \"report_id\": \"{{reportId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/patient_registry/entries",
            "description": "Run 'Parse Spectrum report' first so reportId is set (or remove report_id)."
          },
          "response": []
        },
        {
          "name": "1b. Create manual entry (minimum fields only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 and next bill_no', function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test('bill_no increments by one', function () {",
                  "  const prev = parseInt(pm.collectionVariables.get('billNo') || '0', 10);",
                  "  pm.expect(parseInt(j.entry.bill_no, 10)).to.eql(prev + 1);",
                  "});",
                  "pm.test('name title removed and title-cased', function () { pm.expect(j.entry.patient_name).to.eql('Asha Patel'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_key\": \"home_lab\",\n  \"patient_name\": \"MRS. ASHA PATEL\",\n  \"registration_date\": \"{{regDate}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/patient_registry/entries",
            "description": "Minimum to save: name, registration date, lab."
          },
          "response": []
        },
        {
          "name": "2. Same patient again (exact match by lab PID) -> merged, same bill_no",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 merged, not a new entry', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
