      ]
    },
    {
      "name": "Admin - Requests and Grants",
      "description": "Admin-only workflow. To test per-lab access, pre-grant staff the module with submodule \"spectrum\" (edit the body), then log in as staff and run the Patient Registry requests: Metropolis must return 403.",
      "item": [
        {
          "name": "List pending requests",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/access/requests" },
          "response": []
        },
        {
          "name": "Approve request",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/v1/access/requests/{{grantId}}/approve" },
          "response": []
        },
        {
          "name": "Deny request",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/v1/access/requests/{{grantId}}/deny" },
          "response": []
        },
        {
          "name": "Pre-grant module access",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('grantId', pm.response.json().id); }"
