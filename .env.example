# Copy to .env for local development. NEVER commit .env.
# Secrets and environment values only; everything else lives in config/*.yaml.

# local | production | test
ENVIRONMENT=local
# Atlas SRV string in production
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=trustushealth
# mongo | drive (default: mongo). Google Drive stores report files privately.
FILE_STORE=mongo
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_ROOT_FOLDER_ID=
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-minimum
FRONTEND_ORIGIN=http://localhost:3000
# First Admin; created at startup if missing
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Email. Local: Mailpit catches OTP mails at http://localhost:8025.
# Use google_apps_script on Render Free; use smtp for local Mailpit.
# smtp | gmail | google_apps_script
MAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
# Gmail requires 2-Step Verification and a Google App Password (not your account password).
# Set these when MAIL_TRANSPORT=gmail. Gmail uses smtp.gmail.com over TLS (port 465).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Set both when MAIL_TRANSPORT=google_apps_script. Keep the shared secret private.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# Scheduled jobs (used from build step 1 onward)
JOB_SECRET=
ADMIN_REPORT_EMAILS=

# Monitoring (optional)
SENTRY_DSN=

# Future incoming Gmail API integration (OAuth; separate from outgoing Gmail SMTP)
# GMAIL_CLIENT_ID= / GMAIL_CLIENT_SECRET= / GMAIL_REFRESH_TOKEN=
# WHATSAPP_TOKEN= / WHATSAPP_PHONE_NUMBER_ID=
